<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Only durable user-controlled preferences are eligible for cloud backup. -->
        <include domain="sharedpref" path="geo_weather_prefs.xml" />
        <include domain="sharedpref" path="geoweather_features.xml" />
        <include domain="sharedpref" path="location_alert_preferences.xml" />
        <include domain="sharedpref" path="location_backup.xml" />
    </cloud-backup>

    <device-transfer>
        <!-- Keep device transfer aligned with cloud backup. -->
        <include domain="sharedpref" path="geo_weather_prefs.xml" />
        <include domain="sharedpref" path="geoweather_features.xml" />
        <include domain="sharedpref" path="location_alert_preferences.xml" />
        <include domain="sharedpref" path="location_backup.xml" />
    </device-transfer>
</data-extraction-rules>
