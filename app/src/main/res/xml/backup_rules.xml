<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Android 11 and lower: keep Auto Backup limited to durable user preferences. -->
    <include domain="sharedpref" path="geo_weather_prefs.xml" />
    <include domain="sharedpref" path="geoweather_features.xml" />
    <include domain="sharedpref" path="location_alert_preferences.xml" />
        <include domain="sharedpref" path="location_backup.xml" />

    <!-- Device-specific or rebuildable state must not be restored. -->
    <exclude domain="sharedpref" path="weather_widget_preferences.xml" />
    <exclude domain="sharedpref" path="weather_alert_dedupe.xml" />
    <exclude domain="sharedpref" path="forecast_change_history.xml" />
    <exclude domain="sharedpref" path="search_history.xml" />
    <exclude domain="sharedpref" path="launch_state.xml" />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
